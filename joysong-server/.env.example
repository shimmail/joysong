# Database
DB_URL=jdbc:mysql://localhost:3306/joysong?useUnicode=true&characterEncoding=utf8&useSSL=true&serverTimezone=Asia/Shanghai
DB_USERNAME=joysong_app
DB_PASSWORD=

# JWT
JWT_SECRET=

# Bootstrap administrator (required on first startup; use a unique strong password)
ADMIN_PHONE=
ADMIN_PASSWORD=

# Google
GOOGLE_CLIENT_ID=
# Optional: proxy used only for Google ID Token verification, not for API/image/AI traffic.
GOOGLE_PROXY_URL=

# Aliyun OSS
OSS_ENABLED=true
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=
OSS_PUBLIC_BASE_URL=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Aliyun SMS
SMS_ENABLED=true
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# Payment is fail-closed by default. Set live mode only after all Stripe
# credentials and the public HTTPS webhook endpoint have been configured.
PAYMENT_MODE=disabled
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://example.com/payment/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://example.com/payment/cancel
# Optional; normally keep Stripe's public API endpoint and account default API version.
STRIPE_API_BASE=https://api.stripe.com
STRIPE_API_VERSION=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_PRODUCT_NAME=Joysong medical service
PAYMENT_RECONCILIATION_ENABLED=true
PAYMENT_RECONCILIATION_DELAY_MS=60000
PAYMENT_RECONCILIATION_STALE_SECONDS=120

# Server
SERVER_BASE_URL=http://localhost:8080
# Share page base URL used by /api/diaries/{id}/share
APP_SHARE_BASE_URL=http://localhost:8080/s/diary/
# Local upload root. In production, use an absolute persistent directory, e.g. /var/lib/joysong/uploads
UPLOAD_LOCAL_DIR=./data/uploads

# LLM (OpenAI-compatible relay)
# Never commit a real key. Copy this file to .env or configure these variables
# in your IDE/server process.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://www.fastaitoken.com/v1
# FastAIToken documentation uses this model in its compatibility example.
# You can replace it with another exact id returned by GET /v1/models.
# AI Agent 模型；未设置时兼容读取 OPENAI_MODEL。
AI_AGENT_MODEL=gpt-5.5
# 翻译默认使用百炼 qwen3.7-flash；可改为 openai。
TRANSLATION_PROVIDER=qwen
TRANSLATION_FALLBACK_PROVIDER=openai
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-flash
# OpenAI 兜底翻译模型（评论、回复、私信、日记正文）。
TRANSLATION_MODEL=gpt-5.5
