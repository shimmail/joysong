# Database
DB_URL=jdbc:mysql://localhost:3306/joysong?useUnicode=true&characterEncoding=utf8&useSSL=true&serverTimezone=Asia/Shanghai
DB_USERNAME=joysong_app
DB_PASSWORD=

# JWT
JWT_SECRET=

# Bootstrap administrator (required on first startup; use a unique strong password)
ADMIN_PHONE=
ADMIN_PASSWORD=

# Google
GOOGLE_CLIENT_ID=
# Optional: proxy used only for Google ID Token verification, not for API/image/AI traffic.
GOOGLE_PROXY_URL=

# Aliyun OSS
OSS_ENABLED=true
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=
OSS_PUBLIC_BASE_URL=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Aliyun SMS
SMS_ENABLED=true
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# Legacy Stripe compatibility only. New orders use the unavailable-safe Alipay+ slot.
# Leave disabled unless startup reports unresolved historical Stripe query/refund liabilities.
STRIPE_LEGACY_ENABLED=false
# When temporarily enabled, keep both keys outside version control.
STRIPE_SECRET_KEY=sk_test_<from Stripe Dashboard; do not commit a real key>
STRIPE_WEBHOOK_SECRET=whsec_<from Stripe CLI or Dashboard; do not commit a real secret>

STRIPE_API_BASE=https://api.stripe.com
STRIPE_API_VERSION=

STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_PRODUCT_NAME=Joysong legacy medical service

PAYMENT_RECONCILIATION_ENABLED=true
PAYMENT_RECONCILIATION_DELAY_MS=60000
PAYMENT_RECONCILIATION_STALE_SECONDS=120

# Development-only order auto-payment. Keep false outside an explicit local dev profile.
DEVELOPMENT_ORDER_AUTO_PAYMENT_ENABLED=false

# Server
SERVER_BASE_URL=http://localhost:8080
# Share page base URL used by /api/diaries/{id}/share
APP_SHARE_BASE_URL=http://localhost:8080/s/diary/
# Local upload root. In production, use an absolute persistent directory, e.g. /var/lib/joysong/uploads
UPLOAD_LOCAL_DIR=./data/uploads

# AI Agent. Never commit a real key. Copy this file to .env or configure these
# variables in your IDE/server process.
AI_AGENT_PROVIDER=qwen
AI_AGENT_API_KEY=
AI_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_AGENT_MODEL=qwen-plus
AI_AGENT_INTENT_MODEL=qwen-turbo

# Translation Agent. These values are independent from AI_AGENT_* and are read
# from the development/server process environment.
TRANSLATION_PROVIDER=qwen
TRANSLATION_API_KEY=
TRANSLATION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TRANSLATION_MODEL=qwen3.7-flash
