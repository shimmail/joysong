#!/bin/bash
set -Eeuo pipefail
umask 077

# Re-exec the installed root-owned entrypoint with a minimal environment before
# touching any host resource. This removes runner-controlled import, proxy and
# tool configuration variables at the privilege boundary.
if [[ "$EUID" -eq 0 && "${JOYSONG_UAT_ENV_SANITIZED:-}" != 1 ]]; then
  exec /usr/bin/env -i \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LC_ALL=C JOYSONG_UAT_ENV_SANITIZED=1 \
    /bin/bash /usr/local/sbin/joysong-uat-deploy "$@"
fi

# This is the only privileged interface exposed to the repository runner. The
# workflow can choose an immutable candidate identity; every host resource is
# fixed here and cannot be supplied by CI.
readonly SERVICE=joysong-demo.service
readonly SERVICE_USER=joysong-demo
readonly SERVICE_GROUP=joysong-demo
readonly RUNNER_USER=joysong-gh-runner
readonly PORT=8080
readonly ADMIN_HOST=joyingsong.net
readonly HEALTH_TIMEOUT_SECONDS=90
readonly OUTAGE_LIMIT_SECONDS=180
readonly RECOVERY_RESERVE_SECONDS=90
readonly COMMAND_TIMEOUT_SECONDS=15
readonly CAPACITY_RESERVE_BYTES=536870912
readonly PUBLIC_BUCKET=joysong-demo-media-cn-hangzhou-1335549182926992
readonly PRIVATE_BUCKET=joysong-demo-private-cn-hangzhou-1335549182926992
readonly EXPECTED_DATABASE_NAME=myapp_worktree_uat
readonly EMPTY_DATABASE_SHA256=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855

fail() {
  printf 'JoySong UAT deployment failed: %s\n' "$*" >&2
  exit 2
}

# Production sudo strips these test-only variables. Direct root execution also
# refuses them, so a workflow cannot redirect privileged paths into a fixture.
if [[ -n "${JOYSONG_UAT_TEST_ROOT:-}" ]]; then
  [[ "${JOYSONG_UAT_TESTING:-}" == 1 && "$EUID" -ne 0 ]] ||
    fail "test path override is forbidden for root or outside the test harness"
  readonly PATH_PREFIX="${JOYSONG_UAT_TEST_ROOT%/}"
  readonly PYTHON_BIN=python3
else
  [[ "$EUID" -eq 0 ]] || fail "run as root through the fixed sudoers entry"
  readonly PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  export PATH
  readonly PATH_PREFIX=""
  readonly PYTHON_BIN=/usr/bin/python3
  cd /
fi

host_path() { printf '%s%s' "$PATH_PREFIX" "$1"; }

BACKEND_ROOT="$(host_path /opt/joysong-demo)"
readonly BACKEND_ROOT
readonly BACKEND_RELEASES="$BACKEND_ROOT/releases"
readonly BACKEND_CURRENT="$BACKEND_ROOT/current"
readonly BACKEND_PREVIOUS="$BACKEND_ROOT/previous"
ADMIN_ROOT="$(host_path /var/www/joysong-demo)"
readonly ADMIN_ROOT
readonly ADMIN_RELEASES="$ADMIN_ROOT/releases"
readonly ADMIN_CURRENT="$ADMIN_ROOT/current"
readonly ADMIN_PREVIOUS="$ADMIN_ROOT/previous"
DATA_ROOT="$(host_path /var/lib/joysong-demo)"
readonly DATA_ROOT
readonly UPLOADS="$DATA_ROOT/uploads"
readonly PRIVATE_DATA="$DATA_ROOT/private"
readonly STAGING_DATA="$DATA_ROOT/upload-staging"
CONFIG_FILE="$(host_path /etc/joysong-demo/joysong.env)"
MYSQL_CONFIG="$(host_path /etc/mysql/joysong-uat-backup.cnf)"
NGINX_SITE="$(host_path /etc/nginx/conf.d/joysong-public.conf)"
SYSTEMD_UNIT="$(host_path /etc/systemd/system/joysong-demo.service)"
HOST_CONTRACT="$(host_path /etc/joysong-demo/host-contract)"
DEPLOY_ROOT="$(host_path /var/lib/joysong-deploy)"
readonly CONFIG_FILE MYSQL_CONFIG NGINX_SITE SYSTEMD_UNIT HOST_CONTRACT DEPLOY_ROOT
readonly STATE_ROOT="$DEPLOY_ROOT/state"
readonly BACKUP_ROOT="$DEPLOY_ROOT/backups"
readonly INCOMING_ROOT="$DEPLOY_ROOT/incoming"
readonly LOCK_FILE="$STATE_ROOT/deploy.lock"
readonly TRANSACTION_MARKER="$STATE_ROOT/transaction"
readonly PREVIOUS_IDENTITY="$STATE_ROOT/previous-pair"
readonly LEGACY_ADOPTION_PENDING="$STATE_ROOT/legacy-backend-adoption.pending"
VERIFY_TOOL="$(host_path /usr/local/lib/joysong-deploy/verify-uat-release.py)"
readonly VERIFY_TOOL

TAG_RE='^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)-uat\.(0|[1-9][0-9]*)$'
SHA64_RE='^[0-9a-f]{64}$'
COMMIT_RE='^[0-9a-f]{40}$'
RUN_ID_RE='^[1-9][0-9]{0,18}$'
readonly RUN_ID_MAX=9223372036854775807

validate_arguments() {
  (($# == 5)) || fail "expected action, tag, commit, run ID and bundle SHA-256"
  [[ "$1" == preflight || "$1" == deploy ]] || fail "unsupported action"
  [[ "$2" =~ $TAG_RE ]] || fail "invalid UAT tag"
  [[ "$3" =~ $COMMIT_RE ]] || fail "commit must be 40 lowercase hexadecimal characters"
  [[ "$4" =~ $RUN_ID_RE ]] || fail "run ID must be a positive decimal integer"
  if ((${#4} == 19)); then
    ((10#$4 <= RUN_ID_MAX)) || fail "run ID exceeds signed 64-bit range"
  fi
  [[ "$5" =~ $SHA64_RE ]] || fail "bundle SHA-256 must be 64 lowercase hexadecimal characters"
}

mode_not_writable_by_group_or_other() {
  local mode="$1"
  [[ "$mode" =~ ^[0-7]{3,4}$ ]] && (((8#$mode & 8#022) == 0))
}

require_regular_file() {
  local path="$1" label="$2"
  [[ -f "$path" && ! -L "$path" ]] || fail "$label must be a regular non-link file"
  [[ "$(stat -c '%h' "$path")" == 1 ]] || fail "$label must not have multiple hard links"
}

require_root_protected_file() {
  local path="$1" label="$2"
  require_regular_file "$path" "$label"
  if [[ -z "$PATH_PREFIX" ]]; then
    [[ "$(stat -c '%U' "$path")" == root ]] || fail "$label must be root-owned"
    mode_not_writable_by_group_or_other "$(stat -c '%a' "$path")" ||
      fail "$label must not be writable by group or other"
  fi
}

require_real_directory() {
  local path="$1" label="$2"
  [[ -d "$path" && ! -L "$path" ]] || fail "$label must be a real directory"
}

validate_control_layout() {
  local directory
  for directory in "$BACKEND_ROOT" "$BACKEND_RELEASES" "$ADMIN_ROOT" "$ADMIN_RELEASES" \
    "$DEPLOY_ROOT" "$STATE_ROOT" "$BACKUP_ROOT" "$INCOMING_ROOT"; do
    require_real_directory "$directory" "controlled directory $directory"
    if [[ -z "$PATH_PREFIX" && "$directory" != "$INCOMING_ROOT" ]]; then
      [[ "$(stat -c '%U' "$directory")" == root ]] || fail "$directory must be root-owned"
      mode_not_writable_by_group_or_other "$(stat -c '%a' "$directory")" ||
        fail "$directory must not be writable by group or other"
    fi
  done
  require_root_protected_file "$LOCK_FILE" "deployment lock"
  require_root_protected_file "$VERIFY_TOOL" "release verifier"
  if [[ -z "$PATH_PREFIX" ]]; then
    [[ "$(stat -c '%U:%G:%a' "$INCOMING_ROOT")" == "$RUNNER_USER:$RUNNER_USER:700" ]] ||
      fail "incoming root must be joysong-gh-runner:joysong-gh-runner mode 0700"
  fi
  [[ ! -e "$TRANSACTION_MARKER" && ! -L "$TRANSACTION_MARKER" ]] ||
    fail "an unresolved deployment transaction blocks new work"
  [[ ! -e "$LEGACY_ADOPTION_PENDING" && ! -L "$LEGACY_ADOPTION_PENDING" ]] ||
    fail "an unresolved legacy Backend adoption blocks new work"
}

read_assignment() {
  local file="$1" key="$2" line value
  line="$(grep -E "^[[:space:]]*${key}=" "$file" | tail -n 1 || true)"
  [[ -n "$line" ]] || return 1
  value="${line#*=}"
  value="${value%$'\r'}"
  if [[ "$value" == \"*\" && "$value" == *\" ]]; then
    value="${value:1:${#value}-2}"
  elif [[ "$value" == \'*\' && "$value" == *\' ]]; then
    value="${value:1:${#value}-2}"
  fi
  printf '%s' "$value"
}

file_sha() { sha256sum "$1" | awk '{print $1}'; }

tree_sha() {
  "$PYTHON_BIN" -I - "$@" <<'PY'
from __future__ import print_function
import hashlib, os, stat, sys
root = os.path.realpath(sys.argv[1])
require_root_immutable = len(sys.argv) > 2 and sys.argv[2] == "true"
root_info = os.lstat(sys.argv[1])
if stat.S_ISLNK(root_info.st_mode) or not stat.S_ISDIR(root_info.st_mode):
    raise SystemExit("tree root is unsafe")
if require_root_immutable and (
    root_info.st_uid != 0 or stat.S_IMODE(root_info.st_mode) & 0o022
):
    raise SystemExit("release tree root is mutable to a non-root user")
digest = hashlib.sha256()
for parent, directories, files in os.walk(root, followlinks=False):
    directories.sort(); files.sort()
    for name in directories + files:
        path = os.path.join(parent, name)
        info = os.lstat(path)
        if stat.S_ISLNK(info.st_mode) or not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode)):
            raise SystemExit("tree contains a link or special file")
        if stat.S_ISREG(info.st_mode) and info.st_nlink != 1:
            raise SystemExit("tree contains a multiply-linked file")
        if require_root_immutable and (
            info.st_uid != 0 or stat.S_IMODE(info.st_mode) & 0o022
        ):
            raise SystemExit("release tree is mutable to a non-root user")
        relative = os.path.relpath(path, root).replace(os.sep, "/")
        digest.update(relative.encode("utf-8")); digest.update(b"\0")
        digest.update(("%o:%d:%d" % (stat.S_IMODE(info.st_mode), info.st_uid, info.st_gid)).encode("ascii"))
        digest.update(b"\0")
        if stat.S_ISREG(info.st_mode):
            member = hashlib.sha256()
            with open(path, "rb") as stream:
                for chunk in iter(lambda: stream.read(1024 * 1024), b""):
                    member.update(chunk)
            digest.update(member.digest())
print(digest.hexdigest())
PY
}

immutable_tree_sha() { tree_sha "$1" true; }

safe_link_target() {
  local link="$1" releases="$2" target releases_real
  [[ -L "$link" ]] || fail "required release link is missing: $link"
  target="$(readlink -f "$link" 2>/dev/null || true)"
  releases_real="$(readlink -f "$releases" 2>/dev/null || true)"
  [[ -n "$target" && -n "$releases_real" && -d "$target" && ! -L "$target" ]] ||
    fail "release link target is missing or unsafe: $link"
  [[ "$(dirname "$target")" == "$releases_real" && "$(basename "$target")" != .* ]] ||
    fail "release link escapes the fixed releases directory: $link"
  if [[ -z "$PATH_PREFIX" ]]; then
    [[ "$(stat -c '%U' "$target")" == root ]] || fail "release target must be root-owned"
    mode_not_writable_by_group_or_other "$(stat -c '%a' "$target")" ||
      fail "release target must be immutable to non-root users"
  fi
  printf '%s' "$target"
}

atomic_link() {
  local target="$1" link="$2" temporary="${2}.new.$$"
  rm -f -- "$temporary"
  ln -s -- "$target" "$temporary"
  mv -Tf -- "$temporary" "$link"
}

atomic_root_file() {
  local destination="$1" source="$2" temporary="${1}.new.$$"
  if [[ -n "$PATH_PREFIX" ]]; then
    install -m 0600 "$source" "$temporary"
  else
    install -o root -g root -m 0600 "$source" "$temporary"
  fi
  mv -Tf -- "$temporary" "$destination"
}

run_with_timeout() {
  local seconds="$1" remaining
  shift
  if ((ACTIVE_DEADLINE > 0)); then
    remaining=$((ACTIVE_DEADLINE - SECONDS))
    ((remaining > 0)) || return 124
    ((seconds <= remaining)) || seconds="$remaining"
  fi
  if [[ -n "$PATH_PREFIX" ]]; then
    "$@"
  else
    timeout --foreground --signal=TERM --kill-after=3s "${seconds}s" "$@"
  fi
}

DATABASE_HOST=''
DATABASE_PORT=''
DATABASE_NAME=''

load_database_binding() {
  local url configured_name selected_name
  local -a parts
  url="$(read_assignment "$CONFIG_FILE" DB_URL || true)"
  [[ -n "$url" ]] || fail "DB_URL is missing from runtime configuration"
  mapfile -t parts < <("$PYTHON_BIN" -I - "$url" "$EXPECTED_DATABASE_NAME" <<'PY'
from __future__ import print_function
import re, sys
try:
    from urllib.parse import parse_qsl, urlsplit
except ImportError:
    from urlparse import parse_qsl, urlsplit
value, expected_name = sys.argv[1:]
if not value.startswith("jdbc:mysql://"):
    raise SystemExit("DB_URL is not MySQL")
parsed = urlsplit("mysql://" + value[len("jdbc:mysql://"):])
name = parsed.path.lstrip("/")
if parsed.username or parsed.password or not parsed.hostname:
    raise SystemExit("DB_URL authority is unsafe")
for key, setting in parse_qsl(parsed.query, keep_blank_values=True):
    if key.lower() == "createdatabaseifnotexist" and setting.lower() in ("1", "true", "yes", "on"):
        raise SystemExit("DB_URL must not create a database")
if name != expected_name:
    raise SystemExit("database name is not the fixed UAT database")
print(parsed.hostname); print(parsed.port or 3306); print(name)
PY
  )
  ((${#parts[@]} == 3)) || fail "database binding could not be resolved"
  DATABASE_HOST="${parts[0]}"; DATABASE_PORT="${parts[1]}"; DATABASE_NAME="${parts[2]}"
  configured_name="$(read_assignment "$CONFIG_FILE" DEMO_DATABASE_NAME || true)"
  [[ "$configured_name" == "$DATABASE_NAME" ]] ||
    fail "DEMO_DATABASE_NAME does not match the DB_URL database"
  selected_name="$(mysql_query 'SELECT DATABASE()')" || fail "database identity query failed"
  [[ "$selected_name" == "$DATABASE_NAME" ]] || fail "connected database identity does not match DB_URL"
  printf 'Resolved database host: %s\nResolved database name: %s\n' "$DATABASE_HOST" "$DATABASE_NAME"
}

mysql_query() {
  local statement="$1"
  run_with_timeout 30 mysql --defaults-file="$MYSQL_CONFIG" --protocol=TCP \
    --host="$DATABASE_HOST" --port="$DATABASE_PORT" --database="$DATABASE_NAME" \
    --batch --skip-column-names --execute="$statement"
}

flyway_snapshot() {
  local output
  output="$(mysql_query "SELECT installed_rank,COALESCE(version,''),type,script,COALESCE(checksum,''),success FROM flyway_schema_history ORDER BY installed_rank")" || return 1
  "$PYTHON_BIN" -I -c '
from __future__ import print_function
import csv, hashlib, io, sys
rows = list(csv.reader(io.StringIO(sys.stdin.read()), delimiter="\t"))
expected = [str(value) for value in range(33, 41)]
if len(rows) != 8 or any(len(row) != 6 for row in rows):
    raise SystemExit("Flyway history must contain exactly B33 and V34 through V40")
if [row[1] for row in rows] != expected or any(row[5] != "1" for row in rows):
    raise SystemExit("Flyway history version or success state is invalid")
if rows[0][2].upper() != "SQL_BASELINE" or any(row[2].upper() != "SQL" for row in rows[1:]):
    raise SystemExit("Flyway history types must be SQL_BASELINE then SQL")
normalized = "\n".join("\t".join(row) for row in rows) + "\n"
print(hashlib.sha256(normalized.encode("utf-8")).hexdigest())
' <<<"$output"
}

database_state_snapshot() {
  local table_count
  table_count="$(mysql_query "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema=DATABASE()")" || return 1
  [[ "$table_count" =~ ^[0-9]+$ ]] || return 1
  if [[ "$table_count" == 0 ]]; then
    printf '%s\n' "$EMPTY_DATABASE_SHA256"
  else
    flyway_snapshot
  fi
}

nginx_config_sha() {
  require_root_protected_file "$NGINX_SITE" "Nginx JoySong configuration"
  local actual expected
  actual="$(file_sha "$NGINX_SITE")"
  expected="$(read_assignment "$HOST_CONTRACT" NGINX_SITE_SHA256 || true)"
  [[ "$expected" =~ $SHA64_RE && "$actual" == "$expected" ]] || return 1
  printf '%s' "$actual"
}

validate_mysql_option_file() {
  "$PYTHON_BIN" -I - "$MYSQL_CONFIG" "$EXPECTED_DATABASE_NAME" <<'PY'
from __future__ import print_function
import configparser, re, sys
path, expected_database = sys.argv[1:]
parser = configparser.RawConfigParser(interpolation=None, strict=True, allow_no_value=False)
try:
    with open(path, encoding="utf-8") as stream:
        parser.read_file(stream)
except (OSError, configparser.Error) as error:
    raise SystemExit("invalid MySQL option file: {}".format(error))
if parser.sections() != ["client"]:
    raise SystemExit("MySQL option file must contain only [client]")
allowed = {"host", "port", "protocol", "user", "password", "database"}
keys = set(parser["client"])
if not keys <= allowed or not {"host", "port", "user", "password", "database"} <= keys:
    raise SystemExit("MySQL option file contains missing or forbidden keys")
section = parser["client"]
if section["host"] != "127.0.0.1" or section["port"] != "3306" or section["database"] != expected_database:
    raise SystemExit("MySQL option file must select the local UAT database")
if section.get("protocol", "TCP").upper() != "TCP":
    raise SystemExit("MySQL option file protocol must be TCP")
if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]{0,31}", section["user"]) or not section["password"]:
    raise SystemExit("MySQL backup credential is invalid")
PY
}

validate_runtime_configuration() {
  require_root_protected_file "$CONFIG_FILE" "runtime configuration"
  require_root_protected_file "$MYSQL_CONFIG" "database backup configuration"
  require_root_protected_file "$HOST_CONTRACT" "host contract"
  validate_mysql_option_file
  if [[ -z "$PATH_PREFIX" ]]; then
    [[ "$(stat -c '%U:%G:%a' "$MYSQL_CONFIG")" == root:root:600 ]] ||
      fail "database backup configuration must be root:root mode 0600"
    if command -v getenforce >/dev/null 2>&1; then
      [[ "$(getenforce)" == Disabled ]] ||
        fail "the current UAT layout requires SELinux to remain disabled"
    fi
  fi
  [[ "$(read_assignment "$CONFIG_FILE" SPRING_PROFILES_ACTIVE || true)" == demo ]] ||
    fail "runtime profile must remain demo"
  [[ "$(read_assignment "$CONFIG_FILE" SERVER_ADDRESS || true)" == 127.0.0.1 ]] ||
    fail "backend address must remain 127.0.0.1"
  [[ "$(read_assignment "$CONFIG_FILE" SERVER_PORT || true)" == "$PORT" ]] ||
    fail "backend port must remain 8080"
  [[ "$(read_assignment "$CONFIG_FILE" UPLOAD_LOCAL_DIR || true)" == /var/lib/joysong-demo/uploads ]] ||
    fail "upload directory changed unexpectedly"
  [[ "$(read_assignment "$CONFIG_FILE" UPLOAD_PRIVATE_DIR || true)" == /var/lib/joysong-demo/private ]] ||
    fail "private directory changed unexpectedly"
  [[ "$(read_assignment "$CONFIG_FILE" UPLOAD_STAGING_DIR || true)" == /var/lib/joysong-demo/upload-staging ]] ||
    fail "upload staging directory changed unexpectedly"
  [[ "$(read_assignment "$CONFIG_FILE" OSS_BUCKET_NAME || true)" == "$PUBLIC_BUCKET" ]] ||
    fail "public business Bucket binding changed unexpectedly"
  [[ "$(read_assignment "$CONFIG_FILE" OSS_PRIVATE_BUCKET_NAME || true)" == "$PRIVATE_BUCKET" ]] ||
    fail "private business Bucket binding changed unexpectedly"
  require_real_directory "$UPLOADS" "uploads directory"
  require_real_directory "$PRIVATE_DATA" "private directory"
  require_real_directory "$STAGING_DATA" "upload staging directory"
}

systemctl_property() {
  local property="$1" line
  line="$(run_with_timeout "$COMMAND_TIMEOUT_SECONDS" systemctl show "$SERVICE" -p "$property" --no-pager)" || return 1
  [[ "$line" == "$property="* ]] || return 1
  printf '%s' "${line#*=}"
}

systemd_contract_sha() {
  local working environment_line environment_file fragment drop_ins command_line digest expected
  working="$(systemctl_property WorkingDirectory)" || return 1
  environment_line="$(run_with_timeout "$COMMAND_TIMEOUT_SECONDS" systemctl show "$SERVICE" -p EnvironmentFiles --no-pager)" || return 1
  [[ "$environment_line" == EnvironmentFiles=* ]] || return 1
  environment_file="${environment_line#EnvironmentFiles=}"
  fragment="$(systemctl_property FragmentPath)" || return 1
  drop_ins="$(systemctl_property DropInPaths)" || return 1
  command_line="$(systemctl_property ExecStart)" || return 1
  [[ "$working" == /opt/joysong-demo/current ]] || return 1
  [[ "$environment_file" == '/etc/joysong-demo/joysong.env (ignore_errors=no)' ]] || return 1
  [[ "$fragment" == /etc/systemd/system/joysong-demo.service && -z "$drop_ins" ]] || return 1
  [[ "$command_line" == *'path=/usr/bin/java ;'* ]] || return 1
  [[ "$command_line" == *'argv[]=/usr/bin/java -Xms256m -Xmx896m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError -jar /opt/joysong-demo/current/joysong-server.jar ;'* ]] || return 1
  require_root_protected_file "$SYSTEMD_UNIT" "systemd unit"
  digest="$(file_sha "$SYSTEMD_UNIT")" || return 1
  expected="$(read_assignment "$HOST_CONTRACT" SYSTEMD_UNIT_SHA256 || true)"
  [[ "$expected" =~ $SHA64_RE && "$digest" == "$expected" ]] || return 1
  printf '%s' "$digest"
}

mainpid_jar() {
  local pid="$1" jar
  if [[ -n "$PATH_PREFIX" ]]; then
    jar="$(cat "$(host_path /run/joysong-uat-test-main-jar)" 2>/dev/null || true)"
  else
    [[ -r "/proc/$pid/cmdline" ]] || return 1
    jar="$(tr '\0' '\n' <"/proc/$pid/cmdline" | grep -E '/joysong-server\.jar$' | tail -n 1 || true)"
  fi
  [[ -n "$jar" ]] || return 1
  readlink -f "$jar"
}

listener_owned_by_pid() {
  local pid="$1" output
  output="$(run_with_timeout "$COMMAND_TIMEOUT_SECONDS" ss -H -ltnp "sport = :$PORT")" || return 1
  [[ "$(wc -l <<<"$output" | tr -d ' ')" == 1 ]] || return 1
  [[ "$output" == *"127.0.0.1:$PORT"* && "$output" == *"pid=$pid,"* ]]
}

CURRENT_BACKEND=''
