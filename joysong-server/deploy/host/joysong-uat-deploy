CURRENT_ADMIN_TREE_SHA=''
DEPLOY_MODE=''

path_present() { [[ -e "$1" || -L "$1" ]]; }

classify_deployment_mode() {
  local backend_current=false admin_current=false backend_previous=false admin_previous=false
  path_present "$BACKEND_CURRENT" && backend_current=true
  path_present "$ADMIN_CURRENT" && admin_current=true
  path_present "$BACKEND_PREVIOUS" && backend_previous=true
  path_present "$ADMIN_PREVIOUS" && admin_previous=true
  [[ "$backend_current" == "$admin_current" ]] ||
    fail "Backend/Admin current links are incomplete"
  [[ "$backend_previous" == "$admin_previous" ]] ||
    fail "Backend/Admin previous links are incomplete"
  if [[ "$backend_current" == true ]]; then
    DEPLOY_MODE=existing
  else
    [[ "$backend_previous" == false ]] ||
      fail "a fresh deployment must not have previous release links"
    [[ ! -e "$PREVIOUS_IDENTITY" && ! -L "$PREVIOUS_IDENTITY" ]] ||
      fail "a fresh deployment must not have previous release identity"
    DEPLOY_MODE=fresh
  fi
}

load_fresh_state() {
  local active enabled
  [[ ! -e "$BACKEND_CURRENT" && ! -L "$BACKEND_CURRENT" &&
     ! -e "$ADMIN_CURRENT" && ! -L "$ADMIN_CURRENT" &&
     ! -e "$BACKEND_PREVIOUS" && ! -L "$BACKEND_PREVIOUS" &&
     ! -e "$ADMIN_PREVIOUS" && ! -L "$ADMIN_PREVIOUS" ]] ||
    fail "fresh deployment requires current and previous links to be absent"
  active="$(run_with_timeout "$COMMAND_TIMEOUT_SECONDS" systemctl is-active "$SERVICE" 2>/dev/null || true)"
  enabled="$(run_with_timeout "$COMMAND_TIMEOUT_SECONDS" systemctl is-enabled "$SERVICE" 2>/dev/null || true)"
  [[ "$active" == inactive ]] || fail "fresh deployment requires the service to be inactive"
  [[ "$enabled" == disabled ]] || fail "fresh deployment requires the service to be disabled"
  service_stopped_and_port_free || fail "fresh deployment requires 127.0.0.1:8080 to be unused"
  systemd_contract_sha >/dev/null || fail "systemd service contract validation failed"
  [[ "$(systemctl_property User)" == "$SERVICE_USER" && "$(systemctl_property Group)" == "$SERVICE_GROUP" ]] ||
    fail "service user/group contract changed"
  CURRENT_FLYWAY_SHA="$(database_state_snapshot)" || fail "database state could not be validated"
  [[ "$CURRENT_FLYWAY_SHA" == "$EMPTY_DATABASE_SHA256" ]] ||
    fail "fresh deployment requires a database with no tables"
  CURRENT_CONFIG_SHA="$(file_sha "$CONFIG_FILE")"
  CURRENT_NGINX_SHA="$(nginx_config_sha)" || fail "Nginx site contract validation failed"
  CURRENT_SYSTEMD_SHA="$(systemd_contract_sha)" || fail "systemd service contract validation failed"
}

verify_fresh_state_unchanged() {
  local active enabled
  [[ ! -e "$BACKEND_CURRENT" && ! -L "$BACKEND_CURRENT" &&
     ! -e "$ADMIN_CURRENT" && ! -L "$ADMIN_CURRENT" &&
     ! -e "$BACKEND_PREVIOUS" && ! -L "$BACKEND_PREVIOUS" &&
     ! -e "$ADMIN_PREVIOUS" && ! -L "$ADMIN_PREVIOUS" ]] ||
    fail "fresh release links changed before the initial switch"
  active="$(run_with_timeout "$COMMAND_TIMEOUT_SECONDS" systemctl is-active "$SERVICE" 2>/dev/null || true)"
  enabled="$(run_with_timeout "$COMMAND_TIMEOUT_SECONDS" systemctl is-enabled "$SERVICE" 2>/dev/null || true)"
  [[ "$active" == inactive && "$enabled" == disabled ]] ||
    fail "fresh service state changed before the initial switch"
  service_stopped_and_port_free || fail "fresh service or 8080 listener changed before the initial switch"
  [[ "$(database_state_snapshot)" == "$CURRENT_FLYWAY_SHA" ]] ||
    fail "fresh database changed before the initial switch"
  [[ "$(file_sha "$CONFIG_FILE")" == "$CURRENT_CONFIG_SHA" &&
     "$(nginx_config_sha)" == "$CURRENT_NGINX_SHA" &&
     "$(systemd_contract_sha)" == "$CURRENT_SYSTEMD_SHA" ]] ||
    fail "runtime, Nginx or systemd configuration changed before the initial switch"
}

load_deployment_state() {
  classify_deployment_mode
  validate_administrator_configuration || fail "administrator configuration does not match deployment mode"
  if [[ "$DEPLOY_MODE" == fresh ]]; then
    load_fresh_state
  else
    load_current_state
  fi
}

validate_administrator_configuration() {
  # Read secrets directly from the protected file; only its path and the mode
  # cross the process boundary, and validation errors never include values.
  "$PYTHON_BIN" -I - "$CONFIG_FILE" "$DEPLOY_MODE" <<'PY'
import re, sys
path, mode = sys.argv[1:]
values = {}
for raw in open(path, encoding="utf-8"):
    line = raw.rstrip("\r\n")
    if not line.strip() or line.lstrip().startswith("#"):
        continue
    match = re.fullmatch(r"([A-Z][A-Z0-9_]*)=(.*)", line)
    if not match or match.group(1) in values:
        raise SystemExit("runtime configuration has an invalid or duplicate assignment")
    key, value = match.groups()
    if len(value) >= 2 and value[0] in ("'", '"') and value[-1] == value[0]:
        value = value[1:-1]
    values[key] = value
if not re.fullmatch(r"1[0-9]{10}", values.get("ADMIN_PHONE", "")):
    raise SystemExit("ADMIN_PHONE must identify the configured administrator")
if mode == "fresh":
    password = values.get("ADMIN_PASSWORD", "")
    # Match Kotlin String.length, including surrogate pairs, before Flyway runs.
    if password != password.strip() or not 12 <= len(password.encode("utf-16-le")) // 2 <= 128:
        raise SystemExit("fresh deployment requires ADMIN_PASSWORD with 12-128 characters")
elif mode == "existing":
    if "ADMIN_PASSWORD" in values:
        raise SystemExit("existing deployment requires ADMIN_PASSWORD to be removed")
else:
    raise SystemExit("administrator configuration requires a known deployment mode")
PY
}

verify_service_contract() {
  local expected_backend="$1" expected_jar actual_jar active enabled
  active="$(run_with_timeout "$COMMAND_TIMEOUT_SECONDS" systemctl is-active "$SERVICE")" ||
    fail "service is not active"
  [[ "$active" == active ]] || fail "service is not active"
  enabled="$(run_with_timeout "$COMMAND_TIMEOUT_SECONDS" systemctl is-enabled "$SERVICE")" ||
    fail "service is not enabled"
  [[ "$enabled" == enabled ]] || fail "service is not enabled"
  systemd_contract_sha >/dev/null || fail "systemd service path or unit contract changed"
  [[ "$(systemctl_property User)" == "$SERVICE_USER" && "$(systemctl_property Group)" == "$SERVICE_GROUP" ]] ||
    fail "service user/group contract changed"
  CURRENT_PID="$(systemctl_property MainPID)"
  [[ "$CURRENT_PID" =~ ^[1-9][0-9]*$ && "$CURRENT_PID" != 1 ]] || fail "service MainPID is invalid"
  expected_jar="$(readlink -f "$expected_backend/joysong-server.jar" 2>/dev/null || true)"
  actual_jar="$(mainpid_jar "$CURRENT_PID" || true)"
  [[ -n "$expected_jar" && "$actual_jar" == "$expected_jar" ]] ||
    fail "MainPID does not run the current release JAR"
  listener_owned_by_pid "$CURRENT_PID" || fail "MainPID does not exclusively own 127.0.0.1:8080"
}

verify_admin_locally() {
  local expected_admin="$1" expected_sha response root_sha deep_sha
  expected_sha="$(file_sha "$expected_admin/index.html")" || return 1
  response="$(mktemp "$STATE_ROOT/.admin-response.XXXXXX")" || return 1
    if ! run_with_timeout 10 curl -q --noproxy '*' --fail --silent --show-error --max-time 5 \
      -H "Host: $ADMIN_HOST" --output "$response" http://127.0.0.1/; then
    rm -f "$response"; return 1
  fi
  root_sha="$(file_sha "$response")"
  if ! run_with_timeout 10 curl -q --noproxy '*' --fail --silent --show-error --max-time 5 \
      -H "Host: $ADMIN_HOST" --output "$response" http://127.0.0.1/orders; then
    rm -f "$response"; return 1
  fi
  deep_sha="$(file_sha "$response")"
  rm -f "$response"
  [[ "$root_sha" == "$expected_sha" && "$deep_sha" == "$expected_sha" ]]
}

load_current_state() {
  CURRENT_BACKEND="$(safe_link_target "$BACKEND_CURRENT" "$BACKEND_RELEASES")"
  CURRENT_ADMIN="$(safe_link_target "$ADMIN_CURRENT" "$ADMIN_RELEASES")"
  CURRENT_JAR="$CURRENT_BACKEND/joysong-server.jar"
  require_regular_file "$CURRENT_JAR" "current server JAR"
  require_regular_file "$CURRENT_ADMIN/index.html" "current Admin index"
  CURRENT_BACKEND_TREE_SHA="$(immutable_tree_sha "$CURRENT_BACKEND")" ||
    fail "current Backend release tree is not root-owned and immutable"
  CURRENT_ADMIN_TREE_SHA="$(immutable_tree_sha "$CURRENT_ADMIN")" ||
    fail "current Admin release tree is not root-owned and immutable"
  CURRENT_MIGRATION_SHA="$("$PYTHON_BIN" -I "$VERIFY_TOOL" migration-sha "$CURRENT_JAR")" ||
    fail "current server migration digest is invalid"
  [[ "$CURRENT_MIGRATION_SHA" =~ $SHA64_RE ]] || fail "current migration digest is invalid"
  CURRENT_FLYWAY_SHA="$(flyway_snapshot)" || fail "Flyway history validation failed"
  CURRENT_CONFIG_SHA="$(file_sha "$CONFIG_FILE")"
  CURRENT_NGINX_SHA="$(nginx_config_sha)"
  CURRENT_SYSTEMD_SHA="$(systemd_contract_sha)" || fail "systemd service contract validation failed"
  verify_service_contract "$CURRENT_BACKEND"
  verify_admin_locally "$CURRENT_ADMIN" || fail "current Admin root/deep-route contract failed"
}

validate_incoming_bundle() {
  local tag="$1" commit="$2" run_id="$3" bundle_sha="$4" incoming bundle
  incoming="$INCOMING_ROOT/$run_id"
  bundle="$incoming/joysong-uat-${tag}.tar.gz"
  require_real_directory "$incoming" "run-specific incoming directory"
  require_regular_file "$bundle" "incoming deployment bundle"
  if [[ -z "$PATH_PREFIX" ]]; then
    [[ "$(stat -c '%U:%G:%a' "$incoming")" == "$RUNNER_USER:$RUNNER_USER:700" ]] ||
      fail "run-specific incoming directory has unsafe ownership or mode"
    [[ "$(stat -c '%U:%G' "$bundle")" == "$RUNNER_USER:$RUNNER_USER" ]] ||
      fail "incoming deployment bundle has an unexpected owner"
    mode_not_writable_by_group_or_other "$(stat -c '%a' "$bundle")" ||
      fail "incoming deployment bundle is writable by group or other"
  fi
  printf '%s' "$bundle"
}

reject_reused_tag() {
  local tag="$1"
  [[ ! -e "$BACKEND_RELEASES/$tag" && ! -L "$BACKEND_RELEASES/$tag" &&
     ! -e "$ADMIN_RELEASES/$tag" && ! -L "$ADMIN_RELEASES/$tag" &&
     ! -e "$STATE_ROOT/releases/$tag.state" && ! -L "$STATE_ROOT/releases/$tag.state" ]] ||
    fail "release tag is immutable and has already been used"
}

STAGING_ROOT=''
CANDIDATE_ROOT=''
CANDIDATE_MIGRATION_SHA=''

verify_candidate() {
  local tag="$1" commit="$2" run_id="$3" bundle_sha="$4" bundle frozen_bundle output
  bundle="$(validate_incoming_bundle "$tag" "$commit" "$run_id" "$bundle_sha")"
  STAGING_ROOT="$(mktemp -d "$STATE_ROOT/.verify.XXXXXX")"
  CANDIDATE_ROOT="$STAGING_ROOT/payload"
  install -d -m 0700 "$CANDIDATE_ROOT"
  frozen_bundle="$STAGING_ROOT/candidate.tar.gz"
  "$PYTHON_BIN" -I "$VERIFY_TOOL" freeze "$bundle" "$frozen_bundle" "$bundle_sha" >/dev/null ||
    fail "candidate bundle could not be frozen safely"
  output="$("$PYTHON_BIN" -I "$VERIFY_TOOL" "$frozen_bundle" "$CANDIDATE_ROOT" "$tag" "$commit" "$run_id" "$bundle_sha")" ||
    fail "candidate bundle verification failed"
  CANDIDATE_MIGRATION_SHA="$(sed -n 's/^DATABASE_MIGRATIONS_SHA256=//p' <<<"$output")"
  [[ "$CANDIDATE_MIGRATION_SHA" =~ $SHA64_RE ]] || fail "candidate migration digest is missing"
  if [[ "$DEPLOY_MODE" == existing ]]; then
    [[ "$CANDIDATE_MIGRATION_SHA" == "$CURRENT_MIGRATION_SHA" ]] ||
      fail "candidate migrations differ; an isolated restore/migration/rollback drill is required"
  fi
}

validate_persistent_tree() {
  local root="$1"
  if find "$root" -xdev -type l -print -quit | grep -q .; then
    fail "persistent data contains a symbolic link: $root"
  fi
  if find "$root" -xdev ! -type d ! -type f -print -quit | grep -q .; then
    fail "persistent data contains a special file: $root"
  fi
  if find "$root" -xdev -type f -links +1 -print -quit | grep -q .; then
    fail "persistent data contains a multiply-linked file: $root"
  fi
}

database_metrics() {
  mysql_query "SELECT COALESCE(SUM(data_length+index_length),0) FROM information_schema.tables WHERE table_schema=DATABASE(); SELECT COUNT(*) FROM information_schema.tables WHERE table_schema=DATABASE() AND engine <> 'InnoDB'; SELECT COUNT(*) FROM information_schema.events WHERE event_schema=DATABASE();"
}

verify_capacity_and_backup_readiness() {
  local database_bytes non_innodb events data_bytes candidate_bytes backend_bytes admin_bytes
  local backup_available backend_available admin_available backup_required backend_required admin_required
  local -a values
  mapfile -t values < <(database_metrics)
  ((${#values[@]} == 3)) || fail "database backup metrics are incomplete"
  database_bytes="${values[0]}"; non_innodb="${values[1]}"; events="${values[2]}"
  [[ "$database_bytes" =~ ^[0-9]+$ && "$non_innodb" == 0 && "$events" == 0 ]] ||
    fail "online backup requires a measurable all-InnoDB database with no scheduled events"
  for directory in "$UPLOADS" "$PRIVATE_DATA" "$STAGING_DATA"; do validate_persistent_tree "$directory"; done
  data_bytes="$(du -sb "$UPLOADS" "$PRIVATE_DATA" "$STAGING_DATA" | awk '{total += $1} END {print total+0}')"
  candidate_bytes="$(du -sb "$STAGING_ROOT" | awk '{print $1}')"
  backend_bytes="$(du -sb "$CANDIDATE_ROOT/joysong-server.jar" "$CANDIDATE_ROOT/manifest.json" "$CANDIDATE_ROOT/release.json" | awk '{total += $1} END {print total+0}')"
  admin_bytes="$(du -sb "$CANDIDATE_ROOT/admin" | awk '{print $1}')"
  backup_available="$(df -PB1 "$BACKUP_ROOT" | awk 'NR==2 {print $4}')"
  backend_available="$(df -PB1 "$BACKEND_RELEASES" | awk 'NR==2 {print $4}')"
  admin_available="$(df -PB1 "$ADMIN_RELEASES" | awk 'NR==2 {print $4}')"
  [[ "$data_bytes" =~ ^[0-9]+$ && "$candidate_bytes" =~ ^[0-9]+$ &&
     "$backend_bytes" =~ ^[0-9]+$ && "$admin_bytes" =~ ^[0-9]+$ &&
     "$backup_available" =~ ^[0-9]+$ && "$backend_available" =~ ^[0-9]+$ &&
     "$admin_available" =~ ^[0-9]+$ ]] ||
    fail "filesystem capacity could not be measured"
  backup_required=$((CAPACITY_RESERVE_BYTES + candidate_bytes * 2 + data_bytes * 2 + database_bytes * 2))
  backend_required=$((CAPACITY_RESERVE_BYTES + backend_bytes))
  admin_required=$((CAPACITY_RESERVE_BYTES + admin_bytes))
  ((backup_available >= backup_required)) || fail "insufficient free space for verified backups and staging"
  ((backend_available >= backend_required)) || fail "insufficient free space for immutable Backend install"
  ((admin_available >= admin_required)) || fail "insufficient free space for immutable Admin install"
}

install_candidate() {
  local tag="$1" backend_stage admin_stage
  backend_stage="$BACKEND_RELEASES/.${tag}.stage.$$"
  admin_stage="$ADMIN_RELEASES/.${tag}.stage.$$"
  [[ ! -e "$backend_stage" && ! -e "$admin_stage" ]] || fail "candidate staging path already exists"
  install -d -m 0755 "$backend_stage" "$admin_stage"
  install -m 0444 "$CANDIDATE_ROOT/joysong-server.jar" "$backend_stage/joysong-server.jar"
  install -m 0444 "$CANDIDATE_ROOT/manifest.json" "$backend_stage/manifest.json"
  install -m 0444 "$CANDIDATE_ROOT/release.json" "$backend_stage/release.json"
  cp -R --no-preserve=ownership,mode,timestamps,context,xattr "$CANDIDATE_ROOT/admin/." "$admin_stage/"
  find "$admin_stage" -type d -exec chmod 0755 {} +
  find "$admin_stage" -type f -exec chmod 0644 {} +
  if [[ -z "$PATH_PREFIX" ]]; then
    chown -R root:root "$backend_stage" "$admin_stage"
  fi
  mv -- "$backend_stage" "$BACKEND_RELEASES/$tag"
  mv -- "$admin_stage" "$ADMIN_RELEASES/$tag"
  chmod 0555 "$BACKEND_RELEASES/$tag" "$ADMIN_RELEASES/$tag"
}

BACKUP_PATH=''

prepare_mysqldump_option_file() {
  local dump_config
  [[ -n "$STAGING_ROOT" && -d "$STAGING_ROOT" && ! -L "$STAGING_ROOT" ]] || fail "backup staging directory is unavailable"
  dump_config="$(mktemp "$STAGING_ROOT/.mysqldump.XXXXXX.cnf")" || fail "could not create private mysqldump option file"
  chmod 0600 "$dump_config" || fail "could not protect private mysqldump option file"
  "$PYTHON_BIN" -I - "$MYSQL_CONFIG" "$dump_config" "$DATABASE_NAME" <<'PY' || fail "mysqldump option preparation failed"
import configparser, re, sys
source, destination, database = sys.argv[1:]
try:
    with open(source, encoding="utf-8", newline="") as stream:
        original = stream.read()
    # Keep credential quoting, backslashes, comments and line endings exactly
    # as delivered. mysqldump receives its database as a fixed positional arg.
    filtered = "".join(line for line in original.splitlines(keepends=True)
                       if not re.match(r"^[ \t]*database[ \t]*[:=]", line, re.IGNORECASE))
    before = configparser.RawConfigParser(interpolation=None, strict=True)
    after = configparser.RawConfigParser(interpolation=None, strict=True)
    before.read_string(original)
    after.read_string(filtered)
    expected = dict(before["client"])
    if expected.pop("database") != database or dict(after["client"]) != expected:
        raise ValueError("dump option filtering changed unexpected values")
    with open(destination, "w", encoding="utf-8", newline="") as stream:
        stream.write(filtered)
except (OSError, configparser.Error, KeyError, ValueError):
    raise SystemExit("could not prepare private mysqldump option file") from None
PY
  printf '%s' "$dump_config"
}

create_verified_backup() {
  local tag="$1" commit="$2" timestamp identity config_sha_after database_after data_before data_after dump_config
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  BACKUP_PATH="$BACKUP_ROOT/${timestamp}-${tag}"
  [[ ! -e "$BACKUP_PATH" && ! -L "$BACKUP_PATH" ]] || fail "backup path already exists"
  install -d -m 0700 "$BACKUP_PATH"
  install -m 0600 "$CONFIG_FILE" "$BACKUP_PATH/joysong.env"
  data_before="$(for directory in "$UPLOADS" "$PRIVATE_DATA" "$STAGING_DATA"; do tree_sha "$directory"; done | sha256sum | awk '{print $1}')"
  tar --create --gzip --file "$BACKUP_PATH/persistent-data.tar.gz" --directory "$DATA_ROOT" \
    --numeric-owner --acls --xattrs --selinux uploads private upload-staging
  tar --compare --gzip --file "$BACKUP_PATH/persistent-data.tar.gz" --directory "$DATA_ROOT" \
    --numeric-owner --acls --xattrs --selinux >/dev/null ||
    fail "persistent data backup does not reproduce the live tree metadata and content"
  data_after="$(for directory in "$UPLOADS" "$PRIVATE_DATA" "$STAGING_DATA"; do tree_sha "$directory"; done | sha256sum | awk '{print $1}')"
  [[ "$data_before" == "$data_after" ]] || fail "persistent data changed while it was being backed up"
  dump_config="$(prepare_mysqldump_option_file)"
  if ! run_with_timeout 150 mysqldump --defaults-file="$dump_config" --protocol=TCP \
      --host="$DATABASE_HOST" --port="$DATABASE_PORT" --single-transaction --quick \
      --routines --triggers --skip-events --hex-blob --default-character-set=utf8mb4 \
      --set-gtid-purged=OFF --no-tablespaces "$DATABASE_NAME" |
      gzip -n >"$BACKUP_PATH/database.sql.gz"; then
    fail "database backup failed; service state is unchanged"
  fi
  rm -f -- "$dump_config"
  gzip -t "$BACKUP_PATH/database.sql.gz" || fail "database backup gzip verification failed"
  if gzip -cd "$BACKUP_PATH/database.sql.gz" | awk '
      BEGIN { found = 0 }
      /^[[:space:]]*([Cc][Rr][Ee][Aa][Tt][Ee][[:space:]]+[Dd][Aa][Tt][Aa][Bb][Aa][Ss][Ee]|[Uu][Ss][Ee][[:space:]]+)/ { found = 1 }
      END { exit(found ? 0 : 1) }
    '; then
    fail "database backup contains a forbidden database selector"
  fi
  identity="$(mktemp "$STATE_ROOT/.identity.XXXXXX")"
  {
    printf 'TAG=%s\nCOMMIT=%s\nMODE=%s\nDATABASE_HOST=%s\nDATABASE_NAME=%s\n' \
      "$tag" "$commit" "$DEPLOY_MODE" "$DATABASE_HOST" "$DATABASE_NAME"
    printf 'FLYWAY_HISTORY_SHA256=%s\n' "$CURRENT_FLYWAY_SHA"
    if [[ "$DEPLOY_MODE" == existing ]]; then
      printf 'DATABASE_MIGRATIONS_SHA256=%s\n' "$CURRENT_MIGRATION_SHA"
      printf 'BACKEND_TARGET=%s\nBACKEND_JAR_SHA256=%s\nBACKEND_TREE_SHA256=%s\n' \
        "$CURRENT_BACKEND" "$(file_sha "$CURRENT_JAR")" "$CURRENT_BACKEND_TREE_SHA"
      printf 'ADMIN_TARGET=%s\nADMIN_TREE_SHA256=%s\n' "$CURRENT_ADMIN" "$CURRENT_ADMIN_TREE_SHA"
    else
      printf 'DATABASE_MIGRATIONS_SHA256=NONE\nCANDIDATE_MIGRATIONS_SHA256=%s\n' "$CANDIDATE_MIGRATION_SHA"
    fi
    printf 'CONFIG_SHA256=%s\nNGINX_CONFIG_SHA256=%s\nSYSTEMD_UNIT_SHA256=%s\n' "$CURRENT_CONFIG_SHA" "$CURRENT_NGINX_SHA" "$CURRENT_SYSTEMD_SHA"
    printf 'PERSISTENT_DATA_SHA256=%s\n' "$data_before"
    printf 'PUBLIC_BUCKET=%s\nPRIVATE_BUCKET=%s\nCREATED_AT=%s\n' "$PUBLIC_BUCKET" "$PRIVATE_BUCKET" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } >"$identity"
  install -m 0600 "$identity" "$BACKUP_PATH/identity"
  rm -f "$identity"
  (
    cd "$BACKUP_PATH"
    sha256sum database.sql.gz identity joysong.env persistent-data.tar.gz >SHA256SUMS
    sha256sum --check --status SHA256SUMS
    chmod 0600 ./*
  )
  config_sha_after="$(file_sha "$CONFIG_FILE")"
  database_after="$(database_state_snapshot)" || fail "database state could not be revalidated after backup"
  [[ "$config_sha_after" == "$CURRENT_CONFIG_SHA" && "$database_after" == "$CURRENT_FLYWAY_SHA" ]] ||
    fail "runtime configuration or database state changed during backup"
  if [[ "$DEPLOY_MODE" == existing ]]; then
    [[ "$(safe_link_target "$BACKEND_CURRENT" "$BACKEND_RELEASES")" == "$CURRENT_BACKEND" &&
       "$(safe_link_target "$ADMIN_CURRENT" "$ADMIN_RELEASES")" == "$CURRENT_ADMIN" ]] ||
      fail "current release pair changed during backup"
    [[ "$(immutable_tree_sha "$CURRENT_BACKEND")" == "$CURRENT_BACKEND_TREE_SHA" &&
       "$(immutable_tree_sha "$CURRENT_ADMIN")" == "$CURRENT_ADMIN_TREE_SHA" ]] ||
      fail "current release pair content or permissions changed during backup"
  else
    [[ ! -e "$BACKEND_CURRENT" && ! -L "$BACKEND_CURRENT" &&
       ! -e "$ADMIN_CURRENT" && ! -L "$ADMIN_CURRENT" &&
       ! -e "$BACKEND_PREVIOUS" && ! -L "$BACKEND_PREVIOUS" &&
       ! -e "$ADMIN_PREVIOUS" && ! -L "$ADMIN_PREVIOUS" ]] ||
      fail "fresh release links appeared during backup"
    service_stopped_and_port_free || fail "fresh service or 8080 listener changed during backup"
  fi
  printf 'BACKUP_COMPLETE=true\nTAG=%s\nCOMMIT=%s\n' "$tag" "$commit" >"$BACKUP_PATH/BACKUP_COMPLETE"
  chmod 0600 "$BACKUP_PATH/BACKUP_COMPLETE"
  printf 'BACKUP_PATH=%s\n' "$BACKUP_PATH"
}

write_state() {
  local tag="$1" status="$2" downtime="$3" temporary
  install -d -m 0700 "$STATE_ROOT/releases"
  temporary="$(mktemp "$STATE_ROOT/.release-state.XXXXXX")"
  {
    printf 'TAG=%s\nCOMMIT=%s\nRUN_ID=%s\nSTATUS=%s\n' "$tag" "$DEPLOY_COMMIT" "$DEPLOY_RUN_ID" "$status"
    printf 'BUNDLE_SHA256=%s\nDATABASE_MIGRATIONS_SHA256=%s\n' "$DEPLOY_BUNDLE_SHA" "$CANDIDATE_MIGRATION_SHA"
    printf 'BACKUP_PATH=%s\nDOWNTIME_SECONDS=%s\nUPDATED_AT=%s\n' "$BACKUP_PATH" "$downtime" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } >"$temporary"
  atomic_root_file "$STATE_ROOT/releases/$tag.state" "$temporary"
  rm -f "$temporary"
}

write_transaction_marker() {
  local tag="$1" temporary
  temporary="$(mktemp "$STATE_ROOT/.transaction.XXXXXX")"
  {
    printf 'ACTION=deploy\nMODE=%s\nTAG=%s\nCOMMIT=%s\nRUN_ID=%s\n' \
      "$DEPLOY_MODE" "$tag" "$DEPLOY_COMMIT" "$DEPLOY_RUN_ID"
    printf 'FLYWAY_HISTORY_SHA256=%s\n' "$CURRENT_FLYWAY_SHA"
    if [[ "$DEPLOY_MODE" == existing ]]; then
      printf 'OLD_BACKEND=%s\nOLD_ADMIN=%s\n' "$CURRENT_BACKEND" "$CURRENT_ADMIN"
      printf 'OLD_BACKEND_TREE_SHA256=%s\nOLD_ADMIN_TREE_SHA256=%s\n' \
        "$CURRENT_BACKEND_TREE_SHA" "$CURRENT_ADMIN_TREE_SHA"
    fi
    printf 'BACKUP_PATH=%s\nSTARTED_AT=%s\n' "$BACKUP_PATH" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } >"$temporary"
  atomic_root_file "$TRANSACTION_MARKER" "$temporary"
  rm -f "$temporary"
}

wait_for_backend() {
  local expected_backend="$1" old_pid="$2" deadline=$((SECONDS + HEALTH_TIMEOUT_SECONDS)) pid actual
  if ((ACTIVE_DEADLINE > 0 && ACTIVE_DEADLINE < deadline)); then
    deadline="$ACTIVE_DEADLINE"
  fi
  while ((SECONDS < deadline)); do
    if [[ "$(run_with_timeout "$COMMAND_TIMEOUT_SECONDS" systemctl is-active "$SERVICE" 2>/dev/null || true)" == active ]]; then
      pid="$(systemctl_property MainPID 2>/dev/null || true)"
      if [[ "$pid" =~ ^[1-9][0-9]*$ && "$pid" != "$old_pid" ]]; then
        actual="$(mainpid_jar "$pid" 2>/dev/null || true)"
        if [[ "$actual" == "$(readlink -f "$expected_backend/joysong-server.jar")" ]] && listener_owned_by_pid "$pid"; then
          if backend_health_up; then
            CURRENT_PID="$pid"
            return 0
          fi
        fi
      fi
    fi
    if ((ACTIVE_DEADLINE > 0 && SECONDS + 2 >= ACTIVE_DEADLINE)); then
      break
    fi
    sleep 2
  done
  return 1
}

backend_health_up() {
  local body
  body="$(run_with_timeout 10 curl -q --noproxy '*' --fail --silent --show-error \
    --max-time 5 --max-filesize 1048576 http://127.0.0.1:8080/actuator/health 2>/dev/null)" || return 1
  "$PYTHON_BIN" -I -c '
from __future__ import print_function
import json, sys
try:
    value = json.loads(sys.stdin.read())
except (TypeError, ValueError):
    raise SystemExit(1)
raise SystemExit(0 if isinstance(value, dict) and value.get("status") == "UP" else 1)
' <<<"$body"
}

service_stopped_and_port_free() {
  local expected_pid="${1:-}" active listener
  active="$(run_with_timeout "$COMMAND_TIMEOUT_SECONDS" systemctl is-active "$SERVICE" 2>/dev/null || true)"
  [[ "$active" == inactive || "$active" == failed ]] || return 1
  if [[ -n "$expected_pid" && -z "$PATH_PREFIX" && -e "/proc/$expected_pid" ]]; then
    return 1
  fi
  listener="$(run_with_timeout "$COMMAND_TIMEOUT_SECONDS" ss -H -ltnp "sport = :$PORT" 2>/dev/null)" || return 1
  [[ -z "$listener" ]]
}

TRANSACTION_ACTIVE=false
TRANSACTION_COMMITTED=false
PREVIOUS_BINDING_STARTED=false
DEPLOY_TAG=''
DEPLOY_COMMIT=''
DEPLOY_RUN_ID=''
DEPLOY_BUNDLE_SHA=''
OUTAGE_STARTED=0
OUTAGE_DEADLINE=0
CANDIDATE_DEADLINE=0
ACTIVE_DEADLINE=0

previous_pair_unchanged() {
  local backend_sha admin_sha
  backend_sha="$(immutable_tree_sha "$CURRENT_BACKEND")" || return 1
  admin_sha="$(immutable_tree_sha "$CURRENT_ADMIN")" || return 1
  [[ "$backend_sha" == "$CURRENT_BACKEND_TREE_SHA" &&
     "$admin_sha" == "$CURRENT_ADMIN_TREE_SHA" ]]
}

clear_fresh_candidate_links() {
  local link expected actual
  for link in "$BACKEND_CURRENT" "$ADMIN_CURRENT"; do
    if [[ "$link" == "$BACKEND_CURRENT" ]]; then
      expected="$BACKEND_RELEASES/$DEPLOY_TAG"
    else
      expected="$ADMIN_RELEASES/$DEPLOY_TAG"
    fi
    if path_present "$link"; then
      [[ -L "$link" ]] || return 1
      actual="$(readlink -f "$link" 2>/dev/null || true)"
      [[ -n "$actual" && "$actual" == "$(readlink -f "$expected" 2>/dev/null || true)" ]] || return 1
    fi
  done
  rm -f -- "$BACKEND_CURRENT" "$ADMIN_CURRENT"
}

recover_on_failure() {
  local code=$? history_now='' recovered=false stopped=false elapsed=0
  trap - EXIT INT TERM
  set +e
  if [[ -n "$STAGING_ROOT" && -d "$STAGING_ROOT" ]]; then rm -rf --one-file-system "$STAGING_ROOT"; fi
  if [[ "$code" -ne 0 && "$TRANSACTION_ACTIVE" == true && "$TRANSACTION_COMMITTED" == false ]]; then
    ((OUTAGE_DEADLINE > 0)) || OUTAGE_DEADLINE=$((OUTAGE_STARTED + OUTAGE_LIMIT_SECONDS))
    ACTIVE_DEADLINE="$OUTAGE_DEADLINE"
    run_with_timeout "$COMMAND_TIMEOUT_SECONDS" systemctl stop "$SERVICE" >/dev/null 2>&1 || true
    if service_stopped_and_port_free "$CURRENT_PID"; then
      stopped=true
    else
      run_with_timeout "$COMMAND_TIMEOUT_SECONDS" systemctl disable "$SERVICE" >/dev/null 2>&1 || true
      run_with_timeout "$COMMAND_TIMEOUT_SECONDS" systemctl stop "$SERVICE" >/dev/null 2>&1 || true
      service_stopped_and_port_free "$CURRENT_PID" && stopped=true
    fi
    if [[ "$stopped" != true ]]; then
      printf 'CRITICAL: failed candidate could not be confirmed stopped; transaction marker remains and the old JAR was not reconnected.\n' >&2
      exit "$code"
    fi
    if [[ "$DEPLOY_MODE" == fresh ]]; then
      history_now="$(database_state_snapshot 2>/dev/null)"
      run_with_timeout "$COMMAND_TIMEOUT_SECONDS" systemctl disable "$SERVICE" >/dev/null 2>&1 || true
      if [[ -n "$history_now" && "$history_now" == "$CURRENT_FLYWAY_SHA" ]] &&
          clear_fresh_candidate_links && service_stopped_and_port_free "$CURRENT_PID"; then
        elapsed=$((SECONDS - OUTAGE_STARTED))
        if write_state "$DEPLOY_TAG" failed-retryable "$elapsed" && rm -f "$TRANSACTION_MARKER"; then
          recovered=true
          printf 'Candidate failed before changing the empty database; fresh links were removed and failure evidence was retained.\n' >&2
        else
          printf 'CRITICAL: fresh state was restored but evidence or marker cleanup failed; transaction marker remains.\n' >&2
        fi
      fi
      if [[ "$recovered" != true ]]; then
        run_with_timeout "$COMMAND_TIMEOUT_SECONDS" systemctl disable "$SERVICE" >/dev/null 2>&1 || true
        run_with_timeout "$COMMAND_TIMEOUT_SECONDS" systemctl stop "$SERVICE" >/dev/null 2>&1 || true
        printf 'CRITICAL: fresh deployment changed database state or could not be restored; service is disabled and the transaction marker remains for operator review.\n' >&2
      fi
      ACTIVE_DEADLINE=0
      exit "$code"
    fi
    history_now="$(flyway_snapshot 2>/dev/null)"
    if [[ -n "$history_now" && "$history_now" == "$CURRENT_FLYWAY_SHA" ]] &&
        previous_pair_unchanged; then
      atomic_link "$CURRENT_BACKEND" "$BACKEND_CURRENT" &&
        atomic_link "$CURRENT_ADMIN" "$ADMIN_CURRENT" &&
        run_with_timeout "$COMMAND_TIMEOUT_SECONDS" systemctl start "$SERVICE" &&
        wait_for_backend "$CURRENT_BACKEND" "$CURRENT_PID" &&
        verify_admin_locally "$CURRENT_ADMIN" &&
        run_with_timeout "$COMMAND_TIMEOUT_SECONDS" systemctl enable "$SERVICE" &&
        ((SECONDS <= OUTAGE_DEADLINE)) && recovered=true
    fi
    if [[ "$recovered" == true && "$PREVIOUS_BINDING_STARTED" == false ]]; then
      elapsed=$((SECONDS - OUTAGE_STARTED))
      if write_state "$DEPLOY_TAG" rolled-back "$elapsed"; then
        rm -f "$TRANSACTION_MARKER" ||
          printf 'CRITICAL: rollback succeeded but transaction marker cleanup failed.\n' >&2
      else
        printf 'CRITICAL: rollback succeeded but state recording failed; transaction marker remains.\n' >&2
      fi
      printf 'Candidate failed; the previous Backend/Admin pair was restored because Flyway history was unchanged.\n' >&2
    elif [[ "$recovered" == true ]]; then
      printf 'CRITICAL: the prior current pair was restored, but previous-pair binding was interrupted; transaction marker remains.\n' >&2
    else
      run_with_timeout "$COMMAND_TIMEOUT_SECONDS" systemctl disable "$SERVICE" >/dev/null 2>&1 || true
      run_with_timeout "$COMMAND_TIMEOUT_SECONDS" systemctl stop "$SERVICE" >/dev/null 2>&1 || true
      if service_stopped_and_port_free "$CURRENT_PID"; then
        printf 'CRITICAL: recovery was withheld or failed; service is confirmed stopped and the transaction marker remains for operator review.\n' >&2
      else
        printf 'CRITICAL: recovery failed and stopped state could not be confirmed; transaction marker remains for operator review.\n' >&2
      fi
    fi
  fi
  ACTIVE_DEADLINE=0
  exit "$code"
}
trap recover_on_failure EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

switch_release_pair() {
  local tag="$1" old_pid="$CURRENT_PID" flyway_after config_after nginx_after systemd_after elapsed previous_temp
  write_transaction_marker "$tag"
  OUTAGE_STARTED="$SECONDS"
  OUTAGE_DEADLINE=$((OUTAGE_STARTED + OUTAGE_LIMIT_SECONDS))
  CANDIDATE_DEADLINE=$((OUTAGE_DEADLINE - RECOVERY_RESERVE_SECONDS))
  ACTIVE_DEADLINE="$CANDIDATE_DEADLINE"
  TRANSACTION_ACTIVE=true
  run_with_timeout "$COMMAND_TIMEOUT_SECONDS" systemctl disable "$SERVICE"
  run_with_timeout 50 systemctl stop "$SERVICE"
  service_stopped_and_port_free "$old_pid" || fail "old MainPID, service or 8080 listener did not stop"
  atomic_link "$BACKEND_RELEASES/$tag" "$BACKEND_CURRENT"
  run_with_timeout "$COMMAND_TIMEOUT_SECONDS" systemctl start "$SERVICE"
  wait_for_backend "$BACKEND_RELEASES/$tag" "$old_pid" || fail "candidate backend did not become healthy within 90 seconds"
  flyway_after="$(flyway_snapshot)" || fail "Flyway history could not be validated after candidate startup"
  [[ "$flyway_after" == "$CURRENT_FLYWAY_SHA" ]] || fail "Flyway history changed unexpectedly after candidate startup"
  atomic_link "$ADMIN_RELEASES/$tag" "$ADMIN_CURRENT"
  verify_admin_locally "$ADMIN_RELEASES/$tag" || fail "candidate Admin failed local Host root/deep-route checks"
  run_with_timeout "$COMMAND_TIMEOUT_SECONDS" systemctl enable "$SERVICE"
  ((SECONDS + 3 < CANDIDATE_DEADLINE)) || fail "candidate exhausted the rollback reserve before stability wait"
  sleep 3
  verify_service_contract "$BACKEND_RELEASES/$tag"
  backend_health_up || fail "candidate backend failed the final health check"
  verify_admin_locally "$ADMIN_RELEASES/$tag" || fail "candidate Admin failed final stability check"
  [[ "$(flyway_snapshot)" == "$CURRENT_FLYWAY_SHA" ]] || fail "Flyway history changed during final stability check"
  config_after="$(file_sha "$CONFIG_FILE")"; nginx_after="$(nginx_config_sha)"
  systemd_after="$(systemd_contract_sha)" || fail "systemd service contract changed during deployment"
  [[ "$config_after" == "$CURRENT_CONFIG_SHA" && "$nginx_after" == "$CURRENT_NGINX_SHA" &&
     "$systemd_after" == "$CURRENT_SYSTEMD_SHA" ]] ||
    fail "runtime, Nginx or systemd configuration changed during deployment"
  ((SECONDS < CANDIDATE_DEADLINE)) || fail "candidate exhausted the reserved rollback window"
  PREVIOUS_BINDING_STARTED=true
  atomic_link "$CURRENT_BACKEND" "$BACKEND_PREVIOUS"
  atomic_link "$CURRENT_ADMIN" "$ADMIN_PREVIOUS"
  previous_temp="$(mktemp "$STATE_ROOT/.previous.XXXXXX")"
  {
    printf 'CURRENT_TAG=%s\nPREVIOUS_BACKEND=%s\nPREVIOUS_ADMIN=%s\n' "$tag" "$CURRENT_BACKEND" "$CURRENT_ADMIN"
    printf 'PREVIOUS_BACKEND_SHA256=%s\nPREVIOUS_BACKEND_TREE_SHA256=%s\n' \
      "$(file_sha "$CURRENT_JAR")" "$CURRENT_BACKEND_TREE_SHA"
    printf 'PREVIOUS_ADMIN_SHA256=%s\n' "$CURRENT_ADMIN_TREE_SHA"
    printf 'DATABASE_MIGRATIONS_SHA256=%s\n' "$CURRENT_MIGRATION_SHA"
  } >"$previous_temp"
  atomic_root_file "$PREVIOUS_IDENTITY" "$previous_temp"
  rm -f "$previous_temp"
  elapsed=$((SECONDS - OUTAGE_STARTED))
  ((SECONDS < CANDIDATE_DEADLINE)) || fail "candidate bookkeeping exhausted the reserved rollback window"
  write_state "$tag" deployed "$elapsed"
  TRANSACTION_COMMITTED=true
  TRANSACTION_ACTIVE=false
  PREVIOUS_BINDING_STARTED=false
  rm -f "$TRANSACTION_MARKER" || fail "healthy release committed but transaction marker cleanup failed"
  ACTIVE_DEADLINE=0
  printf 'DOWNTIME_SECONDS=%s\n' "$elapsed"
}

switch_fresh_release_pair() {
  local tag="$1" flyway_after config_after nginx_after systemd_after elapsed
  verify_fresh_state_unchanged
  write_transaction_marker "$tag"
  OUTAGE_STARTED="$SECONDS"
  OUTAGE_DEADLINE=$((OUTAGE_STARTED + OUTAGE_LIMIT_SECONDS))
  CANDIDATE_DEADLINE=$((OUTAGE_DEADLINE - RECOVERY_RESERVE_SECONDS))
  ACTIVE_DEADLINE="$CANDIDATE_DEADLINE"
  TRANSACTION_ACTIVE=true
  CURRENT_PID=0
  atomic_link "$BACKEND_RELEASES/$tag" "$BACKEND_CURRENT"
  run_with_timeout "$COMMAND_TIMEOUT_SECONDS" systemctl start "$SERVICE"
  wait_for_backend "$BACKEND_RELEASES/$tag" 0 || fail "initial candidate backend did not become healthy within 90 seconds"
  flyway_after="$(flyway_snapshot)" ||
    fail "initial candidate did not create exactly B33 and V34 through V40"
  atomic_link "$ADMIN_RELEASES/$tag" "$ADMIN_CURRENT"
  verify_admin_locally "$ADMIN_RELEASES/$tag" || fail "initial candidate Admin failed local Host root/deep-route checks"
  run_with_timeout "$COMMAND_TIMEOUT_SECONDS" systemctl enable "$SERVICE"
  ((SECONDS + 3 < CANDIDATE_DEADLINE)) || fail "initial candidate exhausted the recovery reserve before stability wait"
  sleep 3
  verify_service_contract "$BACKEND_RELEASES/$tag"
  backend_health_up || fail "initial candidate backend failed the final health check"
  verify_admin_locally "$ADMIN_RELEASES/$tag" || fail "initial candidate Admin failed final stability check"
  [[ "$(flyway_snapshot)" == "$flyway_after" ]] || fail "Flyway history changed during initial stability check"
  config_after="$(file_sha "$CONFIG_FILE")"; nginx_after="$(nginx_config_sha)"
  systemd_after="$(systemd_contract_sha)" || fail "systemd service contract changed during initial deployment"
  [[ "$config_after" == "$CURRENT_CONFIG_SHA" && "$nginx_after" == "$CURRENT_NGINX_SHA" &&
     "$systemd_after" == "$CURRENT_SYSTEMD_SHA" ]] ||
    fail "runtime, Nginx or systemd configuration changed during initial deployment"
  ((SECONDS < CANDIDATE_DEADLINE)) || fail "initial candidate exhausted the reserved recovery window"
  elapsed=$((SECONDS - OUTAGE_STARTED))
  write_state "$tag" deployed "$elapsed"
  TRANSACTION_COMMITTED=true
  TRANSACTION_ACTIVE=false
  rm -f "$TRANSACTION_MARKER" || fail "healthy initial release committed but transaction marker cleanup failed"
  ACTIVE_DEADLINE=0
  printf 'DOWNTIME_SECONDS=%s\n' "$elapsed"
}

preflight() {
  local tag="$1" commit="$2" run_id="$3" bundle_sha="$4"
  reject_reused_tag "$tag"
  validate_runtime_configuration
  load_database_binding
  load_deployment_state
  verify_candidate "$tag" "$commit" "$run_id" "$bundle_sha"
  verify_capacity_and_backup_readiness
  printf 'PREFLIGHT_OK=true\nDEPLOY_MODE=%s\nCURRENT_BACKEND=%s\nCURRENT_ADMIN=%s\n' \
    "$DEPLOY_MODE" "$CURRENT_BACKEND" "$CURRENT_ADMIN"
  printf 'FLYWAY_HISTORY_SHA256=%s\nDATABASE_MIGRATIONS_SHA256=%s\n' "$CURRENT_FLYWAY_SHA" "$CURRENT_MIGRATION_SHA"
  rm -rf --one-file-system "$STAGING_ROOT"
  STAGING_ROOT=''
  CANDIDATE_ROOT=''
}

deploy() {
  local tag="$1" commit="$2" run_id="$3" bundle_sha="$4"
  reject_reused_tag "$tag"
  validate_runtime_configuration
  load_database_binding
  load_deployment_state
  verify_candidate "$tag" "$commit" "$run_id" "$bundle_sha"
  verify_capacity_and_backup_readiness
  if [[ "$DEPLOY_MODE" == fresh ]]; then
    create_verified_backup "$tag" "$commit"
    [[ "$(database_state_snapshot)" == "$CURRENT_FLYWAY_SHA" ]] ||
      fail "database state changed after the fresh backup; service start was not attempted"
    install_candidate "$tag"
    switch_fresh_release_pair "$tag"
  else
    install_candidate "$tag"
    create_verified_backup "$tag" "$commit"
    [[ "$(flyway_snapshot)" == "$CURRENT_FLYWAY_SHA" ]] || fail "Flyway history changed after backup; service switch was not started"
    switch_release_pair "$tag"
  fi
  rm -rf --one-file-system "$STAGING_ROOT"
  STAGING_ROOT=''
  CANDIDATE_ROOT=''
  printf 'UAT Candidate 已部署，公网未 Ready\nTAG=%s\nCOMMIT=%s\nBACKUP_PATH=%s\n' "$tag" "$commit" "$BACKUP_PATH"
}

main() {
  local action tag commit run_id bundle_sha
  validate_arguments "$@"
  action="$1"; tag="$2"; commit="$3"; run_id="$4"; bundle_sha="$5"
  DEPLOY_TAG="$tag"; DEPLOY_COMMIT="$commit"; DEPLOY_RUN_ID="$run_id"; DEPLOY_BUNDLE_SHA="$bundle_sha"
  validate_control_layout
  exec 9<"$LOCK_FILE"
  flock -n 9 || fail "another UAT deployment is active"
  [[ ! -e "$TRANSACTION_MARKER" && ! -L "$TRANSACTION_MARKER" ]] ||
    fail "an unresolved deployment transaction blocks new work"
  [[ -n "$PATH_PREFIX" ]] || cd "$STATE_ROOT"
  case "$action" in
    preflight) preflight "$tag" "$commit" "$run_id" "$bundle_sha" ;;
    deploy) deploy "$tag" "$commit" "$run_id" "$bundle_sha" ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
